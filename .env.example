PORT=5000
NODE_ENV=development
DB_URI=mongodb://localhost:27017/aladdin-db
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io
SOLANA_TRACKER_TIMEOUT_MS=20000


# Auth
JWT_SECRET=aladdin-dev-jwt-secret-change-in-production
JWT_EXPIRY=24h
ENCRYPTION_KEY=8b8303a3c218a6384128b148622aef5c9e729ce36037ebc7613cd5f2a8fc777e
FRONTEND_LOCAL=http://localhost:3000
MASTER_KEY=9c2eb79ad9854c9d7aede5149522754e9eb32a077f64d7b3cf28b58c0cf31e8e
WALLET_ENCRYPT_KEY=8b8303a3c218a6384128b148622aef5c9e729ce36037ebc7613cd5f2a8fc963e

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Bitquery API (v2 OAuth token) - used when DATA_PROVIDER=bitquery
BITQUERY_API_KEY=
BITQUERY_BASE_URL=https://streaming.bitquery.io/graphql

# Chainstream API (only BSC is provisioned - Solana/Ethereum closed)
CHAINSTREAM_API_KEY=
CHAINSTREAM_BASE_URL=https://graphql.chainstream.io/graphql
DATA_PROVIDER=bitquery


# Ask Aladdin - OpenRouter LLM (leave OPENROUTER_API_KEY empty to run deterministic fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_REFERRAL_URL=http://localhost:5000

# Model tiers: quick = low-latency, deep = higher-quality (used for depth="deep" runs)
OPENROUTER_MODEL_QUICK=openai/gpt-4o-mini
OPENROUTER_MODEL_DEEP=anthropic/claude-sonnet-4-5
OPENROUTER_MODEL_DEFAULT=openai/gpt-4o-mini

# Composer / verifier / engine tuning
AI_TEMPERATURE=0.2
AI_MAX_TOKENS_DEFAULT=1024
AI_TIMEOUT_MS=45000
AI_REQUEST_TIMEOUT_MS=60000
AI_COMPOSER_ENABLED=true
COMPOSER_WORKER_MODE=false
AI_VERIFIER_ENABLED=true
AI_VERIFIER_STRICT=false
AI_QUEUE_ENABLED=false